        <file alias="TSALab.svg">icons/TSALab.svg</file>
        <file alias="TSALab.ico">icons/TSALab.ico</file>
        <file alias="TSALab_glyph.svg">icons/TSALab_glyph.svg</file>
    </qresource>
</RCC>
