IDI_ICON1 ICON "icons/TSALab.ico"

#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Tsaraloha"
            VALUE "FileDescription", "TSALab - Tsaraloha Structural Analysis Laboratory"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "TSALab"
            VALUE "OriginalFilename", "TSALab.exe"
            VALUE "ProductName", "TSALab"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
